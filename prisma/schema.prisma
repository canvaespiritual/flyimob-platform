  identityTokenHash String   @unique @db.Char(64)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastSeenAt        DateTime @default(now())

  sessions AcademySession[]

  @@index([lastSeenAt])
}

model AcademySession {
  id                 String   @id @default(cuid())
  visitorId          String
  collectorTokenHash String   @unique @db.Char(64)
  funnelKey          String   @db.VarChar(80)
  vslKey             String?  @db.VarChar(80)
  videoId            String?  @db.VarChar(200)
  startedAt          DateTime @default(now())
  lastActivityAt     DateTime @default(now())
  expiresAt          DateTime

  source      String? @db.VarChar(200)
  utmSource   String? @db.VarChar(200)
  utmMedium   String? @db.VarChar(200)
  utmCampaign String? @db.VarChar(200)
  utmContent  String? @db.VarChar(200)
  utmTerm     String? @db.VarChar(200)
  utmId       String? @db.VarChar(200)
  fbclid      String? @db.VarChar(500)
  fbp         String? @db.VarChar(256)
  fbc         String? @db.VarChar(512)
  gclid       String? @db.VarChar(500)
  wbraid      String? @db.VarChar(500)
  gbraid      String? @db.VarChar(500)
  campaignId  String? @db.VarChar(120)
  adsetId     String? @db.VarChar(120)
  adId        String? @db.VarChar(120)
  landingPage String? @db.VarChar(2048)
  referrer    String? @db.VarChar(2048)

  currentSecond        Float     @default(0)
  maxReachedSecond     Float     @default(0)
  watchedSeconds       Float     @default(0)
