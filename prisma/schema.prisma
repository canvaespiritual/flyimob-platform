  VGV_PERCENT
  VGV_PERCENT_OVERRIDE
}

enum FinancialStageType {
  ATO
  BANCO
  PREMIO
  COMPLEMENTO
  OUTRO
}

enum FinancialStageStatus {
  EXPECTED
  INVOICED
  AWAITING_RECEIPT
  PARTIALLY_RECEIVED
  RECEIVED
  RESOLVED
  CANCELLED
