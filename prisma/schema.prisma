  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

model AcademySale {
  id                    String              @id @default(cuid())
  provider              AcademySaleProvider @default(HOTMART)
  providerTransactionId String?
  providerOrderId       String?
  leadId                String?
  sessionId             String?
  buyerName             String?             @db.VarChar(160)
  buyerEmail            String?             @db.VarChar(320)
  buyerPhone            String?             @db.VarChar(40)
