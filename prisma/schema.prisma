enum FinancialParticipantRole {
  BROKER
  MANAGER
  FILE_OPERATOR
  MARKETING
  INDICATOR
  CLOSER
  INCORPORATOR
  BONUS
  OTHER
}

enum FinancialCalculationBasis {
  COMMISSION_GROSS
  COMMISSION_NET_AFTER_WITHHOLDING
  COMMISSION_NET_AFTER_ALL_TAXES
  VGV
  FIXED
  MANUAL
}

enum FinancialEntitlementStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

enum FinancialAdjustmentType {
  ADVANCE
  DISCOUNT
  BONUS
  REIMBURSEMENT
  OTHER
}

enum FinancialAdjustmentEffect {
  CREDIT
  DEBIT
}

enum FinancialAdjustmentStatus {
  AVAILABLE
  PARTIAL
  APPLIED
  CANCELLED
