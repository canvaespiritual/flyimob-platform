generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantType {
  IMOBILIARIA
  CORRETOR_AUTONOMO
}

enum UserRole {
  OWNER // proprietário/diretor (full)
  DIRECTOR // opcional se quiser separar do OWNER
  MANAGER
  BROKER
  DATA_ENTRY // operador de cadastro
}

enum EmpreendimentoTipo {
  CONDOMINIO_VERTICAL
  CONDOMINIO_CASAS
  CONDOMINIO_LOTES
  LOTEAMENTO
  APARTAMENTO
  CASA
  LOTE
  COMERCIAL
  GALPAO
  AREA
  FAZENDA
  OUTRO
}

enum FinancingModel {
  CREDITO_ASSOCIATIVO
  FLUXO_ATE_CHAVES
}

enum EmpreendimentoStatus {
  ATIVO
  INATIVO
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  type      TenantType @default(IMOBILIARIA)
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users           User[]
  construtoras    Construtora[]
  empreendimentos Empreendimento[]
  comparativos    Comparativo[] // 👈 NOVO
  inviteTokens    UserInviteToken[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  email        String   @unique
  passwordHash String?
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  passwordResetTokens PasswordResetToken[]
}

model UserInviteToken {
  id        String    @id @default(cuid())
  token     String    @unique
  tenantId  String
  email     String
  role      UserRole  @default(BROKER)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Construtora {
  id       String @id @default(cuid())
  tenantId String

  name    String
  website String?
  logoUrl String?

  cnpj                 String?
  telefone             String?
  email                String?
  endereco             String?
  responsavelComercial String?
  whatsappComercial    String?
  observacao           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  empreendimentos Empreendimento[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Empreendimento {
  id            String  @id @default(cuid())
  tenantId      String
  construtoraId String?

  name String
  slug String
  tipo EmpreendimentoTipo @default(OUTRO)

  status    EmpreendimentoStatus @default(INATIVO)
  publicado Boolean              @default(false)

  endereco String?
  bairro   String?
  cidade   String?
  uf       String?
  cep      String?

  lat Float?
  lng Float?

  descricao      String?
  dataLancamento DateTime?
  dataEntrega    DateTime?

  contatoNome     String?
  contatoTelefone String?
  contatoWhatsapp String?
  observacao      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  construtora Construtora? @relation(fields: [construtoraId], references: [id])

  fotos      EmpreendimentoFoto[]
  anexos     EmpreendimentoAnexo[]
  tipologias EmpreendimentoTipologia[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([lat, lng])
}

model EmpreendimentoFoto {
  id               String   @id @default(cuid())
  empreendimentoId String
  urlFull          String
  urlThumb         String
  ordem            Int      @default(0)
  isCover          Boolean  @default(false)
  createdAt        DateTime @default(now())

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])

  @@index([empreendimentoId])
}

model EmpreendimentoAnexo {
  id               String @id @default(cuid())
  empreendimentoId String

  tipo   String
  titulo String?
  url    String
  ordem  Int     @default(0)

  createdAt DateTime @default(now())

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])

  @@index([empreendimentoId])
}

model EmpreendimentoTipologia {
  id               String @id @default(cuid())
  empreendimentoId String

  nome      String?
  descricao String?

  areaPrivativa Float?
  areaTerreno   Float?

  hectares        Float?
  alqueires       Float?
  valorCondominio Int?

  quartos Int?
  suites  Int?
  vagas   Int?

  totalUnidades Int?
  disponiveis   Int?

  precoInicial Int?
  precoPorM2   Int?
  atualizadoEm DateTime?

  financingModel FinancingModel?

  percentualAteChaves Int?
  valorAvaliacaoBanco Int?
  entradaMinima       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])

  comparativoItems ComparativoItem[] // 👈 NOVO

  @@index([empreendimentoId])
}

/////////////////////////////////////////////////////////
// 🔽🔽🔽  MÓDULO COMPARATIVOS  🔽🔽🔽
/////////////////////////////////////////////////////////

model Comparativo {
  id       String @id @default(cuid())
  tenantId String

  titulo      String
  clienteNome String
  slugPublico String @unique

  // Controle de exibição por BLOCO
  showGeral         Boolean @default(true)
  showEntrada       Boolean @default(true)
  showFinanciamento Boolean @default(true)

  configExibicao Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id])
  items  ComparativoItem[]

  @@index([tenantId])
}

model ComparativoItem {
  id            String @id @default(cuid())
  comparativoId String
  tipologiaId   String
  ordem         Int

  // =========================
  // VALORES PRINCIPAIS
  // =========================
  valorTotal         Float?
  entradaTotal       Float?
  sinalEntrada       Float?
  parcelaEntrada     Float?
  parcelasEntradaQtd Int?

  // =========================
  // PARCELAS FLEXÍVEIS (texto)
  // =========================
  parcelasIntermediarias String?
  parcelasAnuais         String?
  parcelaUnica           String?
  parcelaEspecial        String?

  // =========================
  // FINANCIAMENTO
  // =========================
  saldoFinanciamento   Float?
  parcelaFinanciamento Float?
  taxaJuros            Float?
  rendaBrutaFamiliar   Float?

  // =========================
  // BENEFÍCIOS
  // =========================
  fgts              Float?
  subsidioFederal   Float?
  subsidioEstadual  Float?
  subsidioMunicipal Float?

  // =========================
  // CUSTOS / OBS
  // =========================
  estimativaDocumentacao Float?
  observacao             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comparativo Comparativo             @relation(fields: [comparativoId], references: [id], onDelete: Cascade)
  tipologia   EmpreendimentoTipologia @relation(fields: [tipologiaId], references: [id])

  @@index([comparativoId])
  @@index([tipologiaId])
}
